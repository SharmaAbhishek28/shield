# SHIELD prototype is a frontend-only prototype — no backend, no secrets.
# This file is kept so Vercel's "Environment Variables" UI has something to scaffold from
# once you start wiring real APIs.

# Public site URL — used in metadata, OG tags, etc.
NEXT_PUBLIC_SITE_URL=https://shield.example.com

# Toggle admin views without auth (prototype only — remove before production)
NEXT_PUBLIC_ENABLE_ADMIN=true
